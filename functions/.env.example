# Variables de entorno para Cloud Functions

# ── YCloud (BSP de WhatsApp — envío/recepción y plantillas) ─────────────────────
# API Key del panel de YCloud → Developers → API Keys
YCLOUD_API_KEY=
# Número de WhatsApp remitente en formato E.164, ej: +573001112233
YCLOUD_FROM_NUMBER=
# ID de la cuenta de WhatsApp Business (WABA) — requerido para crear/listar plantillas
# Lo encuentras en YCloud → WhatsApp → Overview/Accounts
YCLOUD_WABA_ID=
# ID numérico del número habilitado para llamadas de voz WhatsApp (YCloud Calling API).
# Distinto del formato E.164 de YCLOUD_FROM_NUMBER — lo da el dashboard de YCloud al
# habilitar "WhatsApp Calling" para ese número. Mientras esté vacío, la llamada de voz
# por WhatsApp queda deshabilitada.
YCLOUD_CALLING_PHONE_ID=
# (Opcional) Número E.164 desde el que se hacen llamadas salientes y se piden
# permisos de llamada. Útil para probar con un número aparte (ej. una SIM
# nueva sin coexistencia) sin mover la mensajería normal. Si se deja vacío,
# usa YCLOUD_FROM_NUMBER.
YCLOUD_CALLING_FROM_NUMBER=

# ── Google OAuth (Calendar + Meet, por asesor) ──────────────────────────────────
# Credenciales del OAuth Client (Web) creado en Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública de la function googleOAuthCallback (debe coincidir EXACTO con el Authorized redirect URI en Google)
GOOGLE_OAUTH_REDIRECT=https://us-central1-crm-conversacional.cloudfunctions.net/googleOAuthCallback
# URL del frontend del CRM (a donde se vuelve tras conectar). Ej local: http://localhost:5173
APP_BASE_URL=
# Zona horaria de las citas
CALENDAR_TIMEZONE=America/Bogota

# ── Dapta (llamadas con IA) ─────────────────────────────────────────────────────
# URL del webhook del flujo de Dapta (Flow Studio, Start tipo Webhook + nodo
# DAPTA_PHONECALL) que inicia la llamada. El CRM le hace POST con
# { phone, name, leadId, companyId }. Forma: https://api.dapta.ai/api/{workspace}/{flow-slug}
# Mientras esté vacío, la función "Llamar con IA" queda deshabilitada.
DAPTA_CALL_TRIGGER_URL=
# API key del flujo de Dapta (se envía como header y query `x-api-key`).
# La ves en el nodo Start del flujo, campo "API Key".
DAPTA_API_KEY=
# (Opcional pero recomendado) Secreto compartido para validar el webhook ENTRANTE
# de Dapta. Si lo defines, configura en Dapta el webhook con ?secret=ESTE_VALOR
# o el header X-Dapta-Secret. Si lo dejas vacío, se valida por IP de origen.
DAPTA_WEBHOOK_SECRET=

# ── Meta (Messenger / Instagram Direct) ─────────────────────────────────────────
# App Secret de la App de Meta ("Meraki CRM") → Configuración → Básica → Clave secreta
META_APP_SECRET=
# Page Access Token de larga duración de la Página conectada (Messenger from Meta →
# Configuración de la API de Messenger → Generar tokens de acceso)
META_PAGE_ACCESS_TOKEN=
# Verify Token elegido al configurar la suscripción del webhook en Meta
META_VERIFY_TOKEN=
# ID de la Página de Facebook (Grupo Constructor Meraki SAS)
META_PAGE_ID=
# ID de la cuenta de Instagram Business vinculada a la Página
META_IG_BUSINESS_ID=

# SMTP Hostinger para invitaciones del CRM
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alertas@grupoconstructormeraki.com.co
SMTP_PASS=
MAIL_FROM="Meraki CRM <alertas@grupoconstructormeraki.com.co>"

# ── Empresa por defecto ────────────────────────────────────────────────────────
DEFAULT_COMPANY_ID=

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Google Calendar ────────────────────────────────────────────────────────────
# En producción: usar Secret Manager de GCP
GOOGLE_APPLICATION_CREDENTIALS=
