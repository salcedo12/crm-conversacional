# Variables de entorno para Cloud Functions
# Configurar con: firebase functions:config:set  (legacy)
# O con Firebase Params / Secret Manager (v2 - recomendado)

# Token de verificación del webhook de WhatsApp (defines tú mismo)
WHATSAPP_VERIFY_TOKEN=

# ID de la empresa por defecto para el MVP (hasta multitenancy)
DEFAULT_COMPANY_ID=

# Ruta al JSON de Service Account de Google (para Calendar API)
# En producción: usar Secret Manager de GCP
GOOGLE_APPLICATION_CREDENTIALS=
