PORT=3333
BRIDGE_API_KEY=change-me
CRM_WEBHOOK_URL=https://us-central1-crm-conversacional.cloudfunctions.net/advisorWhatsappWebhook
CRM_WEBHOOK_SECRET=change-me-too
SESSION_DIR=./data/sessions
# En la VPS: 127.0.0.1 (el CRM entra por nginx/HTTPS). Local: 0.0.0.0
HOST=0.0.0.0
# Pausa entre envios de una sesion (ms) + jitter aleatorio
SEND_MIN_GAP_MS=1500
SEND_JITTER_MS=1500
CRM_POST_TIMEOUT_MS=60000
